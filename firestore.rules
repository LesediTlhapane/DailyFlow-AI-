rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    function isCreatingOwnDoc() {
      return isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /tasks/{taskId} {
      allow create: if isCreatingOwnDoc();
      allow read, update, delete: if isDocOwner();
    }

    match /commitments/{commitmentId} {
      allow create: if isCreatingOwnDoc();
      allow read, update, delete: if isDocOwner();
    }

    match /goals/{goalId} {
      allow create: if isCreatingOwnDoc();
      allow read, update, delete: if isDocOwner();
    }

    match /backlog/{backlogId} {
      allow create: if isCreatingOwnDoc();
      allow read, update, delete: if isDocOwner();
    }

    match /waiting/{waitingId} {
      allow create: if isCreatingOwnDoc();
      allow read, update, delete: if isDocOwner();
    }

    match /chatMemory/{memoryId} {
      allow create: if isCreatingOwnDoc();
      allow read, update, delete: if isDocOwner();
    }
  }
}
